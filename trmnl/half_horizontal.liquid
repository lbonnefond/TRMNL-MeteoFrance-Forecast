{% comment %}

  Adaptation du layout Half Horizontal original
  pour le backend Météo-France.

{% endcomment %}

{% assign MAX_HOURS_DISPLAY_TODAY = trmnl.plugin_settings.custom_fields_values.disp_full_today_max_hours | plus: 0 %}

{% assign weather = IDX_0 %}
{% assign icons = IDX_1.icons %}
{% assign icons_base_url = IDX_1.base_url %}

{% assign DAYS_EN = "Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday" | split: "," %}
{% assign DAYS_FR = "Lundi,Mardi,Mercredi,Jeudi,Vendredi,Samedi,Dimanche" | split: "," %}


{% # CURRENT # %}

{% assign code_str_current = weather.current.weather_code | append: '' %}

{% assign icon_current = icons[code_str_current].night %}

{% if weather.current.is_day == 1 %}
  {% assign icon_current = icons[code_str_current].day %}
{% endif %}

{% assign current_date = weather.current.time | date: '%Y%m%d' %}


{% # FRENCH DAY NAME # %}

{% assign today_day_en = weather.daily.time[0] | date: "%A" %}
{% assign today_day_fr = today_day_en %}

{% for day_en in DAYS_EN %}
  {% if day_en == today_day_en %}
    {% assign today_day_fr = DAYS_FR[forloop.index0] %}
  {% endif %}
{% endfor %}


{% # TODAY # %}

{% # Build array of indices for today's hours # %}

{% assign epoch_current = weather.current.time | date: '%s' %}

{% assign today_hourly_indices = '' %}
{% assign tmp_count = 0 %}

{% for time in weather.hourly.time %}

  {% assign time_epoch = time | date: '%s' %}

  {% if time_epoch > epoch_current and tmp_count < MAX_HOURS_DISPLAY_TODAY %}

    {% assign today_hourly_indices =
      today_hourly_indices
      | append: forloop.index0
      | append: ','
    %}

    {% assign tmp_count = tmp_count | plus: 1 %}

  {% endif %}

{% endfor %}

{% assign today_hourly_indices =
  today_hourly_indices
  | remove_last: ','
  | split: ','
%}


{% # Use Meteo-France daily forecast for today's summary # %}

{% assign code_str_today =
  weather.daily.weather_code[0]
  | append: ''
%}

{% assign icon_today = icons[code_str_today].day %}


{% # LAYOUT # %}

<div class="layout layout--col gap--space-between">

  <!-- ROW 1 current and today -->
  <div class="grid">


    <!-- CURRENT -->
    <div class="col col--span-2 col--start">

      <div class="item h--full">

        <div class="meta"></div>

        <div class="grid grid--cols-1">

          <span class="title">
            Actuellement ({{ weather.current.time | date: '%H:%M' }})
          </span>


          <div class="row row--start">

            <div class="col col--center">

              <img
                style="width: 110px; height: 110px; margin-left: -5px;"
                src="{{ icons_base_url | append: icon_current }}"
              >

            </div>


            <div class="col col--center">

              <span
                class="value value--large"
                data-value-fit="true"
              >
                {{- weather.current.temperature_2m | round }}°
              </span>

            </div>

          </div>


          <span
            class="value"
            data-value-fit="true"
            data-value-fit-max-height="50"
          >
            {{- weather.current.weather_description -}}
          </span>

        </div>

      </div>

    </div>


    <!-- TODAY -->
    <div class="col col--span-4 col--start">

      <div class="item h--full">

        <div class="meta"></div>

        <div class="grid grid--cols-1">


          <span class="title">
            Aujourd'hui &mdash; {{ today_day_fr }}, {{ weather.daily.time[0] | date: "%d.%m.%Y" }}
          </span>


          <div class="grid">

            <div class="grid grid--cols-2">

              <div class="col col--center">

                <img
                  style="width: 75px; height: 75px;"
                  src="{{ icons_base_url | append: icon_today }}"
                >

              </div>


              <div
                class="col col--center"
                style="margin-left: 1em;"
              >

                <span class="value value--small">
                  {{ weather.daily.temperature_2m_max[0] | round }}°
                </span>

                <span class="value value--small text--gray-2">
                  {{ weather.daily.temperature_2m_min[0] | round }}°
                </span>

              </div>

            </div>


            <div class="col--span-3">

              <div class="col col--center">

                <div class="item">

                  <div class="content">

                    <span
                      class="value"
                      data-value-fit="true"
                      data-value-fit-max-height="40"
                    >
                      {{- weather.daily.weather_description[0] -}}
                    </span>

                  </div>

                </div>

              </div>

            </div>

          </div>


          <div class="w-full b-h-gray-3"></div>


          <!-- TODAY HOURLY -->
          <div class="grid grid--cols-{{ MAX_HOURS_DISPLAY_TODAY }}">

            {% for idx_str in today_hourly_indices %}

              {% assign idx = idx_str | plus: 0 %}

              {% assign code_str_hour =
                weather.hourly.weather_code[idx]
                | append: ''
              %}

              {% assign icon_hour = icons[code_str_hour].night %}

              {% if weather.hourly.is_day[idx] == 1 %}
                {% assign icon_hour = icons[code_str_hour].day %}
              {% endif %}


              {% assign style_hour = '' %}

              {% assign hour_date =
                weather.hourly.time[idx]
                | date: '%Y%m%d'
              %}

              {% if hour_date != current_date %}
                {% assign style_hour = 'font-style: italic;' %}
              {% endif %}


              <div class="col col--start">

                <div class="row row--center">

                  <span
                    class="value value--xxsmall"
                    style="{{ style_hour }}"
                  >
                    {{- weather.hourly.time[idx] | date: '%H' -}}
                  </span>

                </div>


                <div class="row row--center">

                  <img
                    style="width: 50px; height: 50px;"
                    src="{{ icons_base_url | append: icon_hour }}"
                  >

                </div>


                <div class="row row--center">

                  <span
                    class="value value--xxsmall"
                    style="margin-left: 0.5em"
                  >
                    {{- weather.hourly.temperature_2m[idx] | round }}°
                  </span>

                </div>

              </div>

            {% endfor %}

          </div>

        </div>

      </div>

    </div>

  </div>

</div>