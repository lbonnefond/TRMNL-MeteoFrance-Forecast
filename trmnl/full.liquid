{% assign weather = IDX_0 %}

{% assign ICON_BASE = 'https://andi4000.github.io/weather-icons/production/monochrome/svg-static/' %}

{% assign MAX_HOURS_TODAY = 7 %}
{% assign TOMORROW_HOURS = '7,9,11,13,15,17,19' | split: ',' %}

{% comment %}
Retourne le nom d'icône correspondant à un code Météo-France.
Le mapping ci-dessous couvre les codes actuellement rencontrés
dans les prévisions de Strasbourg.
{% endcomment %}

{% capture current_icon_name %}
  {% case weather.current.weather_code %}
    {% when 'p1j' %}
      clear-day.svg
    {% when 'p1n' %}
      clear-night.svg

    {% when 'p2j' %}
      partly-cloudy-day.svg
    {% when 'p2n' %}
      partly-cloudy-night.svg
    {% when 'p2bisj' %}
      partly-cloudy-day.svg

    {% when 'p3j' %}
      overcast-day.svg
    {% when 'p3bisj' %}
      overcast-day.svg

    {% when 'p4j' %}
      overcast-day.svg
    {% when 'p4n' %}
      overcast-night.svg

    {% when 'p12j' %}
      partly-cloudy-day-rain.svg
    {% when 'p12bisj' %}
      partly-cloudy-day-rain.svg

    {% when 'p13bisj' %}
      partly-cloudy-day-rain.svg

    {% when 'p14j' %}
      rain.svg
    {% when 'p14n' %}
      rain.svg

    {% when 'p14bisj' %}
      partly-cloudy-day-rain.svg
    {% when 'p14bisn' %}
      partly-cloudy-night-rain.svg

    {% when 'p26n' %}
      thunderstorms-night.svg

    {% else %}
      cloudy.svg
  {% endcase %}
{% endcapture %}

{% assign current_icon_name = current_icon_name | strip %}
{% assign current_icon = ICON_BASE | append: current_icon_name %}


{% comment %}
Prochaines échéances disponibles aujourd'hui.
On ne suppose pas que la résolution reste horaire sur toute la série.
{% endcomment %}

{% assign current_epoch = weather.current.time | date: '%s' %}

{% assign today_indices_string = '' %}
{% assign today_count = 0 %}

{% for forecast_time in weather.hourly.time %}
  {% assign forecast_epoch = forecast_time | date: '%s' %}

  {% if forecast_epoch > current_epoch and today_count < MAX_HOURS_TODAY %}
    {% assign today_indices_string =
      today_indices_string
      | append: forloop.index0
      | append: ','
    %}

    {% assign today_count = today_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% assign today_indices =
  today_indices_string
  | remove_last: ','
  | split: ','
%}


{% comment %}
Pour demain, on sélectionne les heures demandées lorsqu'elles existent.
À J+1, la réponse Météo-France est encore horaire dans notre test actuel.
{% endcomment %}

{% assign tomorrow_date = weather.daily.time[1] %}
{% assign tomorrow_indices_string = '' %}

{% for requested_hour in TOMORROW_HOURS %}

  {% assign formatted_hour =
    requested_hour
    | prepend: '0'
    | slice: -2, 2
  %}

  {% assign target_time =
    tomorrow_date
    | append: 'T'
    | append: formatted_hour
    | append: ':00'
  %}

  {% for forecast_time in weather.hourly.time %}
    {% if forecast_time == target_time %}
      {% assign tomorrow_indices_string =
        tomorrow_indices_string
        | append: forloop.index0
        | append: ','
      %}

      {% break %}
    {% endif %}
  {% endfor %}

{% endfor %}

{% assign tomorrow_indices =
  tomorrow_indices_string
  | remove_last: ','
  | split: ','
%}


<div class="layout layout--col gap--space-between">

  <div class="grid">

    <!-- Conditions actuelles -->
    <div class="col col--span-2 col--start">

      <div class="item h--full">
        <div class="content">

          <span class="title">
            Maintenant — {{ weather.current.time | date: '%H:%M' }}
          </span>

          <div class="row row--center">

            <img
              src="{{ current_icon }}"
              style="width: 110px; height: 110px;"
            >

            <span
              class="value value--large"
              style="margin-left: 12px;"
            >
              {{ weather.current.temperature_2m | round }}°
            </span>

          </div>

          <span
            class="value value--small"
            data-value-fit="true"
          >
            {{ weather.current.weather_description }}
          </span>

        </div>
      </div>

    </div>


    <!-- Aujourd'hui -->
    <div class="col col--span-4 col--start">

      <div class="item h--full">
        <div class="content">

          <span class="title">
            Aujourd’hui — {{ weather.daily.time[0] | date: '%d/%m/%Y' }}
          </span>

          <div class="row row--center">

            <div class="col col--center">

              <span class="value value--small">
                {{ weather.daily.temperature_2m_max[0] | round }}°
              </span>

              <span class="value value--small text--gray-2">
                {{ weather.daily.temperature_2m_min[0] | round }}°
              </span>

            </div>

            <div class="col col--center">

              <span
                class="value value--small"
                data-value-fit="true"
              >
                {{ weather.daily.weather_description[0] }}
              </span>

            </div>

          </div>

          <div class="divider"></div>

          <div class="grid grid--cols-7">

            {% for idx_string in today_indices %}

              {% assign idx = idx_string | plus: 0 %}
              {% assign code = weather.hourly.weather_code[idx] %}

              {% capture icon_name %}
                {% case code %}
                  {% when 'p1j' %}
                    clear-day.svg
                  {% when 'p1n' %}
                    clear-night.svg

                  {% when 'p2j' %}
                    partly-cloudy-day.svg
                  {% when 'p2n' %}
                    partly-cloudy-night.svg
                  {% when 'p2bisj' %}
                    partly-cloudy-day.svg

                  {% when 'p3j' %}
                    overcast-day.svg
                  {% when 'p3bisj' %}
                    overcast-day.svg

                  {% when 'p4j' %}
                    overcast-day.svg
                  {% when 'p4n' %}
                    overcast-night.svg

                  {% when 'p12j' %}
                    partly-cloudy-day-rain.svg
                  {% when 'p12bisj' %}
                    partly-cloudy-day-rain.svg

                  {% when 'p13bisj' %}
                    partly-cloudy-day-rain.svg

                  {% when 'p14j' %}
                    rain.svg
                  {% when 'p14n' %}
                    rain.svg

                  {% when 'p14bisj' %}
                    partly-cloudy-day-rain.svg
                  {% when 'p14bisn' %}
                    partly-cloudy-night-rain.svg

                  {% when 'p26n' %}
                    thunderstorms-night.svg

                  {% else %}
                    cloudy.svg
                {% endcase %}
              {% endcapture %}

              {% assign icon_name = icon_name | strip %}
              {% assign icon_url = ICON_BASE | append: icon_name %}

              <div class="col col--center">

                <span class="value value--xxsmall">
                  {{ weather.hourly.time[idx] | date: '%H' }}
                </span>

                <img
                  src="{{ icon_url }}"
                  style="width: 50px; height: 50px;"
                >

                <span class="value value--xxsmall">
                  {{ weather.hourly.temperature_2m[idx] | round }}°
                </span>

              </div>

            {% endfor %}

          </div>

        </div>
      </div>

    </div>

  </div>


  <div class="divider"></div>


  <!-- Demain -->
  <div class="item">

    <div class="content">

      <span class="title">
        Demain — {{ weather.daily.time[1] | date: '%d/%m/%Y' }}
      </span>

      <div class="grid grid--cols-5">

        <div class="col col--span-1 col--center">

          <span class="value value--small">
            {{ weather.daily.temperature_2m_max[1] | round }}°
          </span>

          <span class="value value--small text--gray-2">
            {{ weather.daily.temperature_2m_min[1] | round }}°
          </span>

          <span
            class="value value--xsmall"
            data-value-fit="true"
          >
            {{ weather.daily.weather_description[1] }}
          </span>

        </div>


        <div class="col col--span-4">

          <div class="grid grid--cols-7">

            {% for idx_string in tomorrow_indices %}

              {% assign idx = idx_string | plus: 0 %}
              {% assign code = weather.hourly.weather_code[idx] %}

              {% capture icon_name %}
                {% case code %}
                  {% when 'p1j' %}
                    clear-day.svg
                  {% when 'p1n' %}
                    clear-night.svg

                  {% when 'p2j' %}
                    partly-cloudy-day.svg
                  {% when 'p2n' %}
                    partly-cloudy-night.svg
                  {% when 'p2bisj' %}
                    partly-cloudy-day.svg

                  {% when 'p3j' %}
                    overcast-day.svg
                  {% when 'p3bisj' %}
                    overcast-day.svg

                  {% when 'p4j' %}
                    overcast-day.svg
                  {% when 'p4n' %}
                    overcast-night.svg

                  {% when 'p12j' %}
                    partly-cloudy-day-rain.svg
                  {% when 'p12bisj' %}
                    partly-cloudy-day-rain.svg

                  {% when 'p13bisj' %}
                    partly-cloudy-day-rain.svg

                  {% when 'p14j' %}
                    rain.svg
                  {% when 'p14n' %}
                    rain.svg

                  {% when 'p14bisj' %}
                    partly-cloudy-day-rain.svg
                  {% when 'p14bisn' %}
                    partly-cloudy-night-rain.svg

                  {% when 'p26n' %}
                    thunderstorms-night.svg

                  {% else %}
                    cloudy.svg
                {% endcase %}
              {% endcapture %}

              {% assign icon_name = icon_name | strip %}
              {% assign icon_url = ICON_BASE | append: icon_name %}

              <div class="col col--center">

                <span class="value value--xxsmall">
                  {{ weather.hourly.time[idx] | date: '%H' }}
                </span>

                <img
                  src="{{ icon_url }}"
                  style="width: 50px; height: 50px;"
                >

                <span class="value value--xxsmall">
                  {{ weather.hourly.temperature_2m[idx] | round }}°
                </span>

              </div>

            {% endfor %}

          </div>

        </div>

      </div>

    </div>

  </div>

</div>